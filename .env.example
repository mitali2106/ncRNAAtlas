# ncRNAAtlas configuration — copy to .env and edit. Placeholder values only; never commit .env.

# Database: SQLite file by default (data/ncrnaatlas.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://ncrnaatlas:CHANGE_ME@localhost:5432/ncrnaatlas
DATABASE_URL=

# Flask
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# Allowed browser origins for /api (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin upload / review endpoints are DISABLED unless a token is set.
ADMIN_TOKEN=

# External services (PubMed, KEGG, MeSH, RNAcentral)
EXTERNAL_LOOKUPS_ENABLED=true
EXTERNAL_TIMEOUT=15
EXTERNAL_RATE_LIMIT_PER_MINUTE=30
# Optional NCBI E-utilities identification (raises the limit to 10 requests/s with a key)
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=ncRNAAtlas

# Uploads
MAX_UPLOAD_MB=25

# Optional: path to the full HGNC complete set (default: data/raw/hgnc_complete_set.txt, else the sample subset)
HGNC_PATH=
